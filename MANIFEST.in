include VERSION
recursive-include src/shared *.h
recursive-include lib/audiorender *.py *.md
recursive-include lib/audiodsp_util *.py
include third_party/tremor/*.c third_party/tremor/*.h third_party/tremor/COPYING third_party/tremor/ORIGIN.txt third_party/tremor/README
recursive-include third_party/microfrontend *.c *.cc *.h LICENSE ORIGIN.txt
recursive-include third_party/kissfft *.c *.h COPYING ORIGIN.txt
# audiomp3: the Helix decoder setup.py fetches into .deps/mp3, patched, so an
# sdist builds without git or a network. Its sources are listed in setup.py; buffers.c is
# included by src/audiomp3/mp3_buffers.c rather than compiled itself.
include .deps/mp3/src/*.h .deps/mp3/src/buffers.c DEPENDENCIES.lock patches/adafruit_mp3/*.patch
include src/cpython/*.h src/audiomp3/mp3_alloc.h
# The type stubs build_py_with_stubs in setup.py installs beside the modules.
include src/*/*.pyi
