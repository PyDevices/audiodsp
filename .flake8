[flake8]
# manifest.py is executed by MicroPython's makemanifest with these names injected.
# manifest.py is run by MicroPython's makemanifest.py, which injects
# c_module(), include(), require() and friends as globals. flake8's
# `builtins` option would name them, but flake8 7.4.0 + pyflakes 4.0.0
# crash on that option (FlakesChecker lost its builtIns attribute), so
# the undefined-name check is switched off for that one file instead.
per-file-ignores =
    manifest.py:F821
# Defect checks only, not formatting opinions.
#
# F   pyflakes: undefined names, unused imports, shadowed definitions,
#     nonlocal declarations for a name nothing assigns - the class of
#     thing that is a bug wherever it appears.
# E9  syntax and IO errors.
# W6  deprecated or removed language features.
#
# Deliberately not pycodestyle's layout rules. The instrument modules are
# ported synthesizer scripts whose compact conditionals are the point, the
# CPython twins of the native modules mirror a C API line for line, and a
# generated module puts MACRO_LABELS and PATCHES above its imports on
# purpose - so E501, E701 and E402 here would be thousands of complaints
# about code that reads the way it is meant to.
select = F,E9,W6

# tests/vendor is third-party code kept as it was published.
# .venv-* as well as .venv: .gitignore has blessed per-worktree venvs
# (`.venv-*/`) since the CircuitPython half landed, and clean-build.yml makes
# a `.ci-venv` in the checkout. Without the glob, `python -m flake8` in any
# worktree that followed that convention lints site-packages and drowns in
# third-party F401s.
extend-exclude =
    .venv,
    .venv-*,
    .ci-venv,
    .deps,
    build,
    dist,
    tests/vendor,
    *.egg-info
